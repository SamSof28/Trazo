{
  "name": "@trazo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @trazo/shared",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prebuild": "npm run build -w @trazo/shared",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @trazo/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @trazo/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@trazo/shared": "*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.10.0",
    "supertest": "^7.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
