# Copiar a backend/.env (nunca commitear valores reales).
# El backend carga backend/.env; el .env de la raíz no se usa.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
# true solo detrás de un proxy de confianza (Render, Railway, Nginx, etc.).
TRUST_PROXY=false

# Supabase: runtime usa el pooler (:6543, ?pgbouncer=true).
# Migraciones y seed usan DIRECT_URL (:5432, sin pgbouncer).
# En Supabase aplica con: npm run db:deploy -w backend
# (db:migrate es solo para desarrollo local: requiere shadow database).
# Ejemplo (reemplaza <ref>, <region> y <password>):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Placeholder local: reemplaza por tus credenciales reales antes de migrar.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trazo?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/trazo?schema=public

# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=
# El access token vive 15 minutos por defecto (900 segundos).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Solo si el SPA y la API comparten un dominio padre; si no, dejar vacío.
COOKIE_DOMAIN=

# IA: mock para desarrollo/tests sin red. gemini requiere GEMINI_API_KEY.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=45000

LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

# Seed del administrador (solo se usa con npm run db:seed -w backend).
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@trazo.co
ADMIN_PASSWORD=
